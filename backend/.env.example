APP_ENV=development
DATABASE_PATH=kavach.db
FILES_DIR=files
DRY_RUN=1

WA_VERIFY_TOKEN=
WA_TOKEN=
WA_PHONE_ID=
GRAPH_VERSION=v23.0

# Active messaging adapter: meta, twilio, or telegram
WHATSAPP_PROVIDER=meta
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# --- Person 2: analysis engine (kavach/analysis/settings.py) ---
# demo / production refuse a weak HASH_SALT at startup.
HASH_SALT=                # 16+ random chars: python -c "import secrets; print(secrets.token_hex(32))"
LLM_BASE_URL=             # OpenAI-compatible endpoint, e.g. https://api.provider.com/v1
LLM_API_KEY=
LLM_MODEL=
# Vision model that reads screenshots when Tesseract is not installed, e.g. qwen/qwen3.8-27b on Groq
OCR_VISION_MODEL=
SAFE_BROWSING_KEY=        # optional; skipped when empty
VT_API_KEY=               # optional; skipped when empty
NETWORK_CHECKS=1          # 0 = skip WHOIS / Safe Browsing / VirusTotal (offline demo)
PULSE_EMBEDDINGS=tfidf    # e5 = sentence-transformers multilingual-e5-small
DEMO_MODE=0               # 1 = instant cached verdicts for the scripted demo messages
# --- Website API and Call Shield (kavach/web_settings.py) ---
PUBLIC_BASE_URL=http://localhost:8000   # public HTTPS URL Twilio calls back to; used to verify Twilio signatures
DEMO_USER_NUMBER=         # who gets Call Shield alerts: the Telegram chat id when WHATSAPP_PROVIDER=telegram
DEMO_USER_LANG=en         # en or hi: language of Call Shield alerts
CALL_SPEECH_LANG=en-IN    # Twilio speech language for the caller's reason (hi-IN for Hindi)
NEWS_FEEDS=               # comma-separated RSS URLs; empty = the hand-picked demo news, labelled as demo
WEB_ORIGINS=http://localhost:5173,http://localhost:5174
