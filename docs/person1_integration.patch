+async def _handle_bait(message: IncomingMessage, language: str) -> None:
+    """Scam Bait Verifier (Person 2) for forwarded news and scheme posts."""
+    from kavach.analysis.bridge import verify_bait
+
+    request = AnalysisRequest(
+        text=message.text,
+        language=language,
+        source="whatsapp",
+        user_id=message.sender,
+    )
+    try:
+        result = await verify_bait(request)
+    except Exception:
+        await _reply(message.sender, messages.ANALYSIS_UNAVAILABLE, language)
+        return
+
+    await _reply_buttons(
+        message.sender,
+        _format_verdict(result),
+        [("report", "How to report"), ("menu", "Menu")],
+        language,
+    )
+
+
+async def _evidence_from_screenshots(paths: list[str]) -> EvidenceSummary:
+    """Read transaction details from the user's receipts (Person 2's OCR)."""
+    if not paths:
+        return EvidenceSummary()
+    try:
+        from kavach.analysis.bridge import evidence_summary
+
+        return await evidence_summary(paths)
+    except Exception:
+        # The PDF still goes out; the user adds any missing details by hand.
+        return EvidenceSummary()
+
